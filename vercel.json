{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @echoatlas/workbench",
  "outputDirectory": "apps/workbench/dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "includeFiles": "{services/backend/src/**,apps/workbench/public/generated-demo/{before.png,after.png,bundle.json}}",
      "excludeFiles": "{services/backend/tests/**,docs/**,plans/**,prototypes/**,fixtures/**,data/**,apps/workbench/public/generated-demo/{candidate-overlay.png,change-score.png,candidates.geojson,prepared-demo-manifest.json}}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
