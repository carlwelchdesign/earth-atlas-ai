{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.echoatlas.local/analysis-bundle/v1/aoi.schema.json",
  "title": "EchoAtlas analysis bundle area of interest v1",
  "type": "object",
  "required": [
    "type",
    "contract_version",
    "bundle_id",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "contract_version": {
      "$ref": "https://schemas.echoatlas.local/analysis-bundle/v1/common.schema.json#/$defs/bundleVersion"
    },
    "bundle_id": {
      "$ref": "https://schemas.echoatlas.local/analysis-bundle/v1/common.schema.json#/$defs/identifier"
    },
    "geometry": {
      "$ref": "https://schemas.echoatlas.local/analysis-bundle/v1/common.schema.json#/$defs/polygon"
    },
    "properties": {
      "type": "object",
      "required": [
        "aoi_id",
        "label",
        "boundary",
        "geometry_sha256"
      ],
      "properties": {
        "aoi_id": {
          "$ref": "https://schemas.echoatlas.local/analysis-bundle/v1/common.schema.json#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "geometry_sha256": {
          "$ref": "https://schemas.echoatlas.local/analysis-bundle/v1/common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
